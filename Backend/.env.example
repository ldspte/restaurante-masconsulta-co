# ══════════════════════════════════════════════════════════════════════
#  PLANTILLA · copiela a  .env  y ajuste los valores
#
#  El sistema arranca sin este archivo usando valores de desarrollo, pero
#  NO debe salir a produccion asi.
# ══════════════════════════════════════════════════════════════════════

# ── Base de datos (MySQL o MariaDB) ───────────────────────────────────
RST_DB_HOST=127.0.0.1
RST_DB_PORT=3306
RST_DB_USER=
RST_DB_PASS=

# Base maestra: sedes y licencias.
RST_MASTER_DB=rst_master
# Prefijo de la base de cada sede. El sistema le pega el codigo de la sede
# directamente:  rst_ + central = rst_central.
RST_TENANT_PREFIX=rst_

# ── Seguridad ─────────────────────────────────────────────────────────
# Dejela VACIA: el instalador genera una de 64 caracteres y la escribe aqui.
# Con esta clave se firman los tokens de sesion; si es corta o predecible,
# cualquiera puede fabricar uno valido y entrar como administrador.
RST_SECRET_KEY=
RST_TOKEN_EXP_HORAS=12

# Debe ser el dominio real. En localhost el navegador bloquea las peticiones
# del propio sitio.
RST_CORS_ORIGINS=http://127.0.0.1:8100

# ── URL publica ───────────────────────────────────────────────────────
# Va en los correos de reserva.
RST_SITIO_URL=http://127.0.0.1:8100

# ── Correo ────────────────────────────────────────────────────────────
# Sin RESEND_API_KEY el sistema funciona igual: la reserva se guarda, el
# cliente ve su codigo en pantalla y el correo solo se anota en el registro.
# El remitente debe ser de un dominio VERIFICADO en Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Respaldo por SMTP. Solo se usa si RESEND_API_KEY queda vacia. Ojo: el
# hosting compartido de GoDaddy bloquea el SMTP saliente.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Operacion ─────────────────────────────────────────────────────────
RST_LOG_LEVEL=INFO

# Limites por IP y por hora. El de login va aparte y mas bajo: es el que
# frena a quien prueba contraseñas.
RST_RATE_LIMIT=240
RST_RATE_LIMIT_LOGIN=10

RST_POOL_SIZE=5
RST_MAX_OVERFLOW=5
RST_POOL_RECYCLE=1800

RST_HOST=127.0.0.1
RST_PORT=8100
RST_RELOAD=0
