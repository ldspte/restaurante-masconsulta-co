# ══════════════════════════════════════════════════════════════════════
#  PLANTILLA DE PRODUCCIÓN · renómbrela a  .env  y complete los valores
#
#  ESTE ARCHIVO NO LLEVA CONTRASEÑAS. Escríbalas directamente en el
#  servidor, no aquí, y nunca lo suba a un repositorio.
# ══════════════════════════════════════════════════════════════════════

# ── Base de datos ─────────────────────────────────────────────────────
# REGLA UNICA: copie los nombres EXACTOS que muestre cPanel en «Bases de
# datos MySQL», sin agregarles ni quitarles nada.
#
# Ojo: no todas las cuentas se comportan igual. En esta el USUARIO lleva el
# prefijo de la cuenta (hhii3aoach68_lpardo1982) pero las BASES no
# (rstmaster, rstcentral). Suponerlo al reves produce un «Unknown database»
# que parece un problema de permisos y no lo es.
RST_DB_HOST=localhost
RST_DB_PORT=3306
RST_DB_USER=
RST_DB_PASS=
RST_MASTER_DB=
# Prefijo de las bases por sede, SIN guion bajo al final: el sistema le pega
# el codigo de la sede directamente. Con RST_TENANT_PREFIX=rst la sede
# «central» vive en la base «rstcentral».
RST_TENANT_PREFIX=

# ── Seguridad ─────────────────────────────────────────────────────────
# Genérela así y péguela aquí. Si es corta o predecible, cualquiera puede
# fabricar un token válido y entrar como administrador:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
RST_SECRET_KEY=

# Horas que dura la sesión antes de pedir la clave otra vez.
RST_TOKEN_EXP_HORAS=12

# Debe ser el dominio real. Dejarlo en localhost hace que el navegador
# bloquee las peticiones del propio sitio.
RST_CORS_ORIGINS=https://restaurante.masconsulta.co

# ── Límites ───────────────────────────────────────────────────────────
RST_RATE_LIMIT=300
RST_RATE_LIMIT_LOGIN=10

# ── Registro ──────────────────────────────────────────────────────────
# En producción, INFO. Poner DEBUG escribe las consultas en el registro y
# llena el disco de la cuenta en pocos días.
# ── Zona horaria del negocio ──────────────────────────────────────────
# El servidor puede estar en otro pais: el de GoDaddy que usa este despliegue
# esta en Phoenix (UTC-7) y el restaurante en Bogota (UTC-5). Sin esto, entre
# medianoche y las 2 a.m. el sistema cree que sigue siendo ayer: «las reservas
# de hoy» salen vacias y los consecutivos anuales se equivocan el 1 de enero.
RST_TZ=America/Bogota
# Solo se usa si el servidor no tiene base de datos de zonas horarias.
RST_TZ_OFFSET=-5

RST_LOG_LEVEL=INFO

# ══════════════════════════════════════════════════════════════════════
#  CORREO
#  Mismos nombres que usa NIGC: un solo .env sirve para los dos sistemas.
#
#  IMPORTANTE · el hosting compartido de GoDaddy BLOQUEA los puertos SMTP
#  salientes. Un envío por SMTP no falla rápido: se queda esperando y deja
#  la pantalla congelada. Por eso se usa Resend, que sale por HTTPS.
#
#  Orden: si hay RESEND_API_KEY se usa Resend; si no, SMTP; si tampoco,
#  el sistema funciona igual y el correo solo se anota en el registro.
# ══════════════════════════════════════════════════════════════════════

# Clave de https://resend.com  (empieza por «re_»)
RESEND_API_KEY=

# El dominio del remitente debe estar VERIFICADO en Resend. Si todavía no
# verificó masconsulta.co, use un remitente de un dominio que sí lo esté
# —qmspm.com, por ejemplo— o los correos se rechazan.
EMAIL_FROM=Restaurante Central <reservas@masconsulta.co>

# A donde responde el cliente. NO es cosmetico: un remitente sin direccion de
# respuesta valida es una de las senales que los filtros usan para mandar el
# correo a la carpeta de no deseado. Ponga un buzon REAL que alguien lea.
RST_REPLY_TO=

# Dirección pública del sitio. Se usa para armar el enlace «ver o cancelar
# mi reserva» que va en el correo.
RST_SITIO_URL=https://restaurante.masconsulta.co

# ── SMTP · solo como respaldo, y solo si el servidor lo permite ────────
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
